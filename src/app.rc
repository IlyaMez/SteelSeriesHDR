#include <windows.h>
#include "version.h"

1 ICON "assets/arena.ico"

1 VERSIONINFO
FILEVERSION ARENA_VERSION_NUM
PRODUCTVERSION ARENA_VERSION_NUM
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS VS_FF_PRERELEASE
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Ilya Mezerowsky"
            VALUE "FileDescription", "Arena HDR - screen lighting for Arena 7"
            VALUE "FileVersion", ARENA_VERSION
            VALUE "InternalName", "ArenaHDR"
            VALUE "LegalCopyright", "Copyright 2026 Ilya Mezerowsky"
            VALUE "OriginalFilename", "ArenaHDR.exe"
            VALUE "ProductName", "Arena HDR"
            VALUE "ProductVersion", ARENA_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
